# OS metadata
.DS_Store

# Editor files
.vscode/
.idea/
*.swp

# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Build and generated output
dist/
build/
*.egg-info/

# Local logs
*.log
agents.zip

# Local role context (agents/role_operations/) -- may carry real platform,
# team, or data specifics once filled in; never commit it. Anchored to the
# repo root so it does not also hide templates/role_operations/role_context.yml,
# the committed, placeholders-only template.
/role_context.yml
/role_context.yaml

# Local model-plugin registration (agents/optimization/model_plugin_registration/)
# -- registers real internal models; never commit it. Anchored to the repo root
# so it does not also hide templates/optimization/model_plugin_manifest.yml, the
# committed, placeholders-only template.
/model_plugins.yml
/model_plugins.yaml

# Local knowledge-source manifest (agents/knowledge/) -- instructions/knowledge_base.md
# tells an adopter to copy the template here and "set real paths", so a filled-in
# copy names internal repositories and filesystem locations; never commit it.
# Anchored to the repo root so it does not also hide
# templates/knowledge/knowledge_sources.yml, the committed, placeholders-only
# template. Same pattern as role_context.yml and model_plugins.yml above.
/knowledge_sources.yml
/knowledge_sources.yaml

# Local author identity (workflow_memory.py's resolve_author, spec 0048) -- read
# before git config/OS username; referenced as gitignored in the module's own
# docstring but missing here until now.
/identity.yml

# Local secrets for dev-only credential resolution (agents/secrets_management/
# credential_access) -- never committed; sources/*.yml's credential_ref only
# ever names the env var to read, never the value.
.env
*.env.local

# Local morning-brief personalization (spec 0059, agents/economists/
# morning_brief_writer/) -- watchlist, delivery route, and schedule are personal,
# not scaffold. Anchored to the repo root, same pattern as role_context.yml,
# so it does not hide templates/data/morning_brief_config.yml.
/morning_brief_config.yml
/morning_brief_config.yaml

# Local generated market-research candidates (spec 0059) -- real pulled
# commentary and agent-written analysis; specs/0056's own Non-Goals are
# explicit that real research content must never be committed to this
# repository, unlike research/, which holds only fictional reference data.
/research_local/

# Local data artifacts -- the operator produces these from their own accounts
# (e.g. fred_local.db via the FRED pipeline with their own API key). They are
# data, not scaffold, and can be large; the SDK ships code that reads them, never
# the files themselves.
*.db
*.sqlite
*.sqlite3
*.parquet

# Local gate usage telemetry (scripts/usage-report.sh). Never committed:
# it is local signal, not a shared artifact.
.qf-usage.tsv
*.qf-usage.tsv
