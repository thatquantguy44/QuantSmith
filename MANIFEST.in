# The analytics domain pack catalog lives outside src/ but is bundled into the
# package at build time (setup.py); the sdist must carry it so a wheel built
# from the sdist bundles it too. Spec 0081 REQ-013.
include setup.py
recursive-include knowledge/analytics_packs *.json
# The vendored agent-skills subset and its lock are bundled the same way
# (spec 0100 REQ-012); graft keeps its dot-directories (.claude-plugin, .claude).
graft vendor/agent-skills
include vendor/agent-skills.lock.json
include config/agent_skills.json
