{
  "schema_version": "0072.1",
  "scope": {
    "jurisdiction": "US",
    "status": "draft_structural_contract"
  },
  "obligations": {
    "when": "consumer_decision is true",
    "required": [
      "reason_codes.derivable is true",
      "reason_codes.excludes_protected_attributes is true",
      "policy_version_field is set",
      "cutoff_field is set",
      "override_log_ref is set",
      "protected_attributes_in_features is empty",
      "disparate_impact_hook is set",
      "fairness_testing.protected_class_basis is set",
      "fairness_testing.disparity_metric is set",
      "fairness_testing.disparity_threshold_param is set",
      "fairness_testing.measured_at_applied_cutoff is true",
      "fairness_testing.feature_proxy_association_recorded is true",
      "fairness_testing.less_discriminatory_alternative.required_when is set"
    ],
    "otherwise": "the record is only valid as consumer_decision true with sole_basis_adverse_action_permitted false, or as a non-consumer path; a consumer path with an unmet obligation and sole basis permitted is rejected by the validator",
    "rationale": "0072 REQ-014 and P4: the unsafe configuration is unrepresentable rather than discouraged. Guidance is skipped under delivery pressure; a validation failure is not. REQ-020 adds the substantive half: attribute absence alone certifies nothing, because disparate impact arises from facially neutral features that correlate with protected class. A contract that only checks a feature list supplies false comfort."
  },
  "protected_attribute_registry": {
    "note": "Named so a feature set can be checked against them mechanically. Listing an attribute here does NOT authorize collecting it; where an institution lawfully holds it, it is used for segregated fairness testing only, never as a model feature. An ESTIMATE of a protected attribute is itself a protected attribute for feature purposes: it is admissible for testing and never as a model input.",
    "attribute_ids": [
      "attr.race",
      "attr.color",
      "attr.religion",
      "attr.national_origin",
      "attr.sex",
      "attr.marital_status",
      "attr.age",
      "attr.receipt_of_public_assistance",
      "attr.exercise_of_ccpa_rights"
    ],
    "source_refs": [
      "cfpb"
    ]
  },
