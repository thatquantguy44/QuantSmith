    {
      "id": "product.term_loan",
      "record_type": "concept",
      "name": "Term loan",
      "kind": "product",
      "aliases": [],
      "definition": "A facility drawn at or near origination and repaid on a schedule. Undrawn commitment is typically absent after drawdown, so exposure at default is closer to outstanding balance than for a revolving facility.",
