      "review": null,
      "supersedes": []
    },
    {
      "id": "entity.guarantor",
      "record_type": "concept",
      "name": "Guarantor",
      "kind": "entity",
      "aliases": [],
      "definition": "A party that assumes an obligation to pay if the obligor does not. A guarantee changes loss given default and may change the effective obligor for risk-weight purposes; it does not change who the obligor is.",
      "parent_ids": [],
      "related_ids": [
        "entity.obligor",
        "measure.lgd.expected"
      ],
