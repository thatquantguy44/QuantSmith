      "supersedes": []
    },
    {
      "id": "entity.counterparty",
      "record_type": "concept",
      "name": "Counterparty",
      "kind": "entity",
      "aliases": [
        "trading counterparty"
      ],
      "definition": "The party to a transaction that gives rise to credit exposure. A counterparty is a transaction-side role; an obligor is a repayment obligation holder. The same legal entity can be both, and the two are not the same object.",
      "parent_ids": [],
      "related_ids": [
        "entity.obligor",
        "concept.exposure"
      ],
      "jurisdiction": "US",
      "knowledge_class": "stable_mechanic",
