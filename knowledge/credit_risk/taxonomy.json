    },
    {
      "id": "product.revolving_facility",
      "record_type": "concept",
      "name": "Revolving credit facility",
      "kind": "product",
      "aliases": [
        "revolver",
        "line of credit"
      ],
      "definition": "A facility the obligor may draw, repay, and redraw up to a limit. Undrawn commitment is the reason exposure at default and drawn balance diverge, and the reason a credit conversion factor is required.",
      "parent_ids": [
        "product.facility"
      ],
      "related_ids": [
        "measure.ccf",
        "measure.ead",
        "measure.drawn_balance"
      ],
