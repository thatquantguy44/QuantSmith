    },
    {
      "id": "product.facility",
      "record_type": "concept",
      "name": "Credit facility",
      "kind": "product",
      "aliases": [
        "credit line",
        "facility"
      ],
      "definition": "A specific credit arrangement extended to an obligor, carrying its own limit, structure, seniority, collateral, and terms. Loss given default and exposure at default attach to the facility, not to the obligor.",
      "parent_ids": [],
      "related_ids": [
