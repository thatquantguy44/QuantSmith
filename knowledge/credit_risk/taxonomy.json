  "concepts": [
    {
      "id": "entity.obligor",
      "record_type": "concept",
      "name": "Obligor",
      "kind": "entity",
      "aliases": [
        "borrower entity",
        "counterparty obligor"
      ],
      "definition": "The legal person contractually obliged to repay a credit exposure. Ratings, probability of default, and default status attach to the obligor, not to any single facility it holds.",
      "parent_ids": [],
      "related_ids": [
        "entity.counterparty",
        "product.facility",
        "concept.exposure",
        "measure.pd"
      ],
      "jurisdiction": "US",
