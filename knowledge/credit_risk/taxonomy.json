    {
      "id": "concept.undrawn_commitment",
      "record_type": "concept",
      "name": "Undrawn commitment",
      "kind": "concept",
      "aliases": [
        "unused commitment",
        "available limit"
      ],
      "definition": "The portion of a committed facility limit not currently drawn. It is off-balance-sheet exposure: it carries credit risk because it can be drawn, typically as credit quality deteriorates.",
