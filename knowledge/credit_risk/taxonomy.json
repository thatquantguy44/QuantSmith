  "ambiguity_rules": [
    {
      "alias": "default",
      "requires": [
        "default_definition_id"
      ],
      "allowed_concept_ids": [
        "defn.default.dpd_90",
        "defn.default.unlikeliness_to_pay",
        "defn.default.irb_reference",
        "defn.default.ifrs9_stage3",
        "defn.default.cecl_nonaccrual",
        "defn.default.internal_watchlist"
      ],
      "resolution": "Callers must name which default definition applies. A PD calibrated to one definition cannot be read against outcomes observed under another."
    },
    {
      "alias": "pd",
      "requires": [
        "horizon",
        "conditioning",
        "default_definition_id"
      ],
      "allowed_concept_ids": [
        "measure.pd.one_year.ttc",
        "measure.pd.one_year.pit",
        "measure.pd.lifetime",
        "measure.observed_default_rate"
      ],
      "resolution": "Resolve horizon, conditioning basis, and default definition before using a probability of default in any formula."
    },
    {
      "alias": "lgd",
      "requires": [
        "conditioning"
      ],
      "allowed_concept_ids": [
        "measure.lgd.expected",
        "measure.lgd.downturn"
      ],
      "resolution": "Expected and downturn loss given default are different parameters; regulatory capital generally requires downturn."
    },
    {
      "alias": "exposure",
      "requires": [
        "exposure_basis"
      ],
      "allowed_concept_ids": [
        "measure.notional",
        "measure.drawn_balance",
        "measure.ead"
      ],
      "resolution": "Resolve whether the amount is notional, drawn balance, or exposure at default, and whether it is gross or net of collateral and guarantees."
    },
    {
      "alias": "loss",
      "requires": [
        "viewpoint_id",
        "loss_basis"
      ],
      "allowed_concept_ids": [
        "measure.el",
        "measure.loss_rate",
        "measure.lgd.expected",
        "measure.charge_off",
        "measure.ecl.lifetime"
      ],
      "resolution": "Loss is a family, not a quantity. Resolve whether it is conditional on default, a portfolio rate, an accounting measurement, or an event."
    },
    {
      "alias": "ecl",
      "requires": [
        "horizon",
        "framework"
      ],
      "allowed_concept_ids": [
        "measure.ecl.twelve_month",
        "measure.ecl.lifetime"
      ],
      "resolution": "Twelve-month and lifetime measurement differ, and IFRS 9 staging is not CECL pooling; name the framework."
    }
  ],
