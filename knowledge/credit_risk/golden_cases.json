{
  "schema_version": "0072.1",
  "point_in_time_rules": [
    {
      "id": "rule.pit.attribute_as_of",
      "statement": "A feature's as-of date must not be after the decision date."
    },
    {
      "id": "rule.pit.outcome_window_alignment",
      "statement": "A value whose outcome window closes after the decision date may be a label but never a feature of that decision."
    },
    {
      "id": "rule.pit.reject_inference",
      "statement": "Any inference about rejected applicants' outcomes is a declared model assumption with a stated method, never an observation."
    },
    {
      "id": "rule.pit.scenario_vintage",
      "statement": "A macroeconomic scenario may not be used before its publication date, even where its projection period covers the target date."
    },
    {
      "id": "rule.pit.restatement_backfill",
      "statement": "A restated financial or a re-rating must not be backfilled over the value that was knowable at the decision date."
    },
    {
      "id": "rule.pit.survivorship",
      "statement": "Closed and charged-off accounts must remain in a population; excluding them biases performance upward."
    }
  ],
  "golden_cases": [
    {
      "id": "golden.el.pd_lgd_ead",
      "case_id": "golden.el.pd_lgd_ead",
      "record_type": "golden_case",
      "name": "Expected loss from PD, LGD, and EAD",
      "domain": "wholesale_rating_pd_lgd_ead",
      "purpose": "Pins the classic identity and, more importantly, that its operands must share a horizon and default definition.",
      "as_of": "2026-09-09",
      "operation": "el_pd_lgd_ead",
      "convention_ids": [
        "convention.el.pd_lgd_ead"
      ],
      "inputs": {
        "pd": {
          "value": 0.02,
          "unit": "probability",
          "horizon": "P1Y",
          "default_definition_id": "defn.default.irb_reference"
        },
        "lgd": {
          "value": 0.45,
          "unit": "fraction_of_ead",
          "horizon": "workout_period",
          "default_definition_id": "defn.default.irb_reference"
        },
        "ead": {
          "value": 1000000.0,
          "unit": "currency_amount",
          "currency": "USD"
        }
      },
      "expected_outputs": {
        "expected_loss": {
          "value": 9000.0,
          "unit": "currency_amount",
          "currency": "USD",
          "tolerance": 1e-09
        }
      },
      "invariants": [
        "Expected loss is positive as a cost to the lender",
        "PD and LGD share a default definition",
        "Collateral is reflected in LGD only, never also in EAD"
      ],
      "jurisdiction": "US",
      "knowledge_class": "stable_mechanic",
      "knowledge_as_of": "2026-09-09",
      "effective_from": null,
      "effective_to": null,
      "source_refs": [
        "bis_basel"
