  "data_time": {
    "fields": {
      "event_time": "When the underlying event occurred (e.g. round closed).",
      "announced_time": "When it was publicly announced.",
      "filed_time": "When a regulator or registry received the filing.",
      "ingested_time": "When a vendor or the adopter loaded it.",
      "known_at": "When the adopter could first have known it; the only time a backtest or model may use."
    },
    "contracts": [
      {
        "id": "contract.survivorship",
        "statement": "A cohort drawn from a database that omits failed or removed companies overstates success rates; the cohort must be defined at an early date from a list not conditioned on outcome.",
        "required_control": "Define the cohort at formation date; report the denominator; compare with a corrected rate.",
        "citation": "unverified",
        "review_status": "draft",
        "review": null
      },
      {
        "id": "contract.backfill",
        "statement": "A vendor may add historical records after the fact with historical dates; those records were not knowable then.",
        "required_control": "Use the vendor's first-seen or ingested time as known_at; if unavailable, snapshot the vendor and treat history as backfilled.",
        "citation": "unverified",
        "review_status": "draft",
        "review": null
      },
      {
        "id": "contract.reporting_lag",
        "statement": "Recent rounds appear in databases with a lag, so the latest periods look quieter than they were.",
        "required_control": "State the lag; do not compare incomplete recent periods with complete earlier ones.",
        "citation": "unverified",
        "review_status": "draft",
        "review": null
      },
      {
        "id": "contract.stealth_omission",
        "statement": "Companies that have not announced funding or hiring are invisible; absence of data is not absence of activity.",
        "required_control": "Report coverage, never imply a complete universe.",
        "citation": "unverified",
        "review_status": "draft",
        "review": null
      }
    ]
  },
  "valuation": [
    {
      "id": "conv.post_money",
      "name": "Post-money valuation",
      "formula": "post_money = pre_money + new_money",
      "unit": "currency",
      "measured_on": "round close",
      "citation": "NVCA Model Legal Documents (public)",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.new_investor_ownership",
      "name": "New-money ownership",
      "formula": "new_ownership = new_money / post_money",
      "unit": "fraction",
      "measured_on": "round close, fully diluted",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.dilution",
      "name": "Existing-holder dilution",
      "formula": "ownership_after = ownership_before * pre_money / post_money (no option-pool change)",
      "unit": "fraction",
      "measured_on": "round close, fully diluted",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.option_pool",
      "name": "Option pool treatment",
      "rule": "State whether a pool top-up is inside pre-money (dilutes existing holders only) or post-money; valuations are not comparable otherwise.",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    }
  ],
  "fund_metrics": [
    {
      "id": "conv.dpi",
      "name": "DPI",
      "formula": "DPI = cumulative_distributions / paid_in_capital",
      "unit": "multiple",
      "measured_on": "report date",
      "citation": "ILPA Reporting Template (public)",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.rvpi",
      "name": "RVPI",
      "formula": "RVPI = residual_nav / paid_in_capital",
      "unit": "multiple",
      "measured_on": "report date",
      "citation": "ILPA Reporting Template (public)",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.tvpi",
      "name": "TVPI",
      "formula": "TVPI = DPI + RVPI",
      "unit": "multiple",
      "measured_on": "report date",
      "citation": "ILPA Reporting Template (public)",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.moic",
      "name": "MOIC (deal level)",
      "formula": "MOIC = (realized_proceeds + unrealized_value) / invested_cost",
      "unit": "multiple",
      "measured_on": "report date",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.irr",
      "name": "IRR",
      "formula": "rate r such that sum(cashflow_i / (1+r)^(t_i)) = 0, with terminal NAV as the final inflow and t in years from first cash flow",
      "unit": "fraction per year",
      "measured_on": "report date",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.ks_pme",
      "name": "Kaplan-Schoar PME",
      "formula": "KS_PME = FV(distributions + NAV, index) / FV(contributions, index)",
      "unit": "multiple",
      "measured_on": "report date",
      "citation": "Kaplan and Schoar (2005), Journal of Finance",
      "review_status": "draft",
      "review": null
    },
    {
      "id": "conv.j_curve",
      "name": "J-curve",
      "rule": "Early-life TVPI and IRR are depressed by fees and unrealized marks; early-life metrics are not comparable with mature funds.",
      "citation": "unverified",
      "review_status": "draft",
      "review": null
    }
  ],
