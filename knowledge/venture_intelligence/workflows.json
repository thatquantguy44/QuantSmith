      "name": "Deal sourcing to diligence memo",
      "decision_path_class": "analytic_support",
      "decision_support_only": false,
      "human_review": [],
      "agents": [
        "deal_sourcing (planned)",
        "company_diligence (planned)",
        "multilingual_document_nlp"
