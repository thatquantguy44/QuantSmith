      "inputs": [
        "Company list or thesis",
        "Source documents"
      ],
      "outputs": [
        "Diligence memo with evidence, assumptions, judgement"
      ],
      "review_gates": [
        "Source grading",
        "Human reviewer sign-off"
      ]
    },
    {
      "id": "workflow.signal_to_thesis",
