      "name": "Repo GC-versus-specific specialness sign",
      "domain": "repo_reverse_repo",
      "purpose": "Positive repo specialness is GC repo rate minus specific-collateral repo rate, not the stock-loan higher-fee convention.",
      "as_of": "2026-09-06",
      "viewpoint_ids": ["role.repo_cash_provider", "role.repo_cash_taker"],
      "convention_ids": ["convention.repo.specialness_bps"],
      "operation": "rate_difference_bps",
      "inputs": {
        "gc_repo_rate": {"value": 0.0525, "unit": "decimal", "as_of": "2026-09-06"},
        "specific_repo_rate": {"value": 0.049, "unit": "decimal", "as_of": "2026-09-06"}
      },
      "expected_outputs": {
        "value": {"value": 35.0, "unit": "basis_points", "tolerance": 0.000001}
      },
      "invariants": [
        "GC rate above specific-collateral rate produces positive repo specialness",
        "Cash provider earns lower rate income on the specific-collateral repo than on GC",
        "Stock-loan specialness signs must not be reused without viewpoint conversion"
      ],
      "jurisdiction": "US",
