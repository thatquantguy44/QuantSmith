      "viewpoint_ids": ["role.securities_borrower", "role.securities_lender", "role.short_seller"],
      "sign_convention": {
        "role.securities_borrower": "positive borrow-fee cost",
        "role.securities_lender": "positive borrow-fee income",
        "role.short_seller": "positive cost reduces short alpha"
      },
      "formula": {
        "id": "formula.simple_accrual",
        "expression": "notional * rate_bps / 10000 * days / day_count_basis",
        "inputs": ["notional", "rate_bps", "days", "day_count_basis"],
        "outputs": ["fee_amount"]
      },
