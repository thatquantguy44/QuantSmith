    {
      "id": "convention.tbill.discount_yield_act360",
      "record_type": "convention",
      "name": "Treasury bill bank discount yield ACT/360",
      "quantity": "discount_yield",
      "quote_style": "discount_yield",
      "unit": "decimal",
      "day_count": "ACT/360",
      "compounding": "discount",
      "calendar": "US_TREASURY_BUSINESS_DAY",
      "business_day_adjustment": "auction_and_settlement_calendar",
      "settlement": {
        "lag": "auction_or_secondary_market_terms",
        "start_inclusion": "settlement_to_maturity",
        "timing": "discount yield is tied to days from settlement to maturity"
      },
      "rounding": {"precision": 0.00000001, "method": "half_even", "applies_at": "output_boundary"},
      "viewpoint_ids": ["role.cash_provider"],
      "sign_convention": {
        "role.cash_provider": "positive yield income when price is below par and security matures at par"
      },
      "formula": {
        "id": "formula.tbill_discount_yield_to_price",
        "expression": "price = par * (1 - discount_yield * days_to_maturity / 360)",
        "inputs": ["par", "discount_yield", "days_to_maturity"],
        "outputs": ["price"]
      },
      "jurisdiction": "US",
