  "conventions": [
    {
      "id": "convention.repo.rate_act360_simple",
      "record_type": "convention",
      "name": "Repo rate ACT/360 simple accrual",
      "quantity": "financing_rate",
      "quote_style": "decimal_rate",
      "unit": "decimal",
      "day_count": "ACT/360",
      "compounding": "simple",
      "calendar": "US_GOVERNMENT_SECURITIES_BUSINESS_DAY",
      "business_day_adjustment": "following_unless_contract_overrides",
      "settlement": {
        "lag": "contractual",
        "start_inclusion": "include_start_exclude_end",
        "timing": "cash and securities exchange according to repo start and end settlement terms"
      },
      "rounding": {"precision": 0.00000001, "method": "half_even", "applies_at": "output_boundary"},
      "viewpoint_ids": ["role.repo_cash_provider", "role.repo_cash_taker"],
      "sign_convention": {
        "role.repo_cash_provider": "positive rate income",
        "role.repo_cash_taker": "positive financing cost"
      },
      "formula": {
        "id": "formula.simple_accrual",
        "expression": "amount * annual_rate * days / day_count_basis",
        "inputs": ["amount", "annual_rate", "days", "day_count_basis"],
        "outputs": ["accrued_amount"]
      },
      "jurisdiction": "US",
      "knowledge_class": "contractual_convention",
      "knowledge_as_of": "2026-09-06",
      "effective_from": null,
      "effective_to": null,
      "source_refs": ["source.ny_fed", "source.dtcc_ficc"],
      "review_status": "draft",
      "review": null,
      "supersedes": []
    },
    {
      "id": "convention.repo.specialness_bps",
      "record_type": "convention",
      "name": "Repo specialness in basis points",
      "quantity": "repo_specialness",
      "quote_style": "basis_points",
      "unit": "basis_points",
      "day_count": "not_applicable",
      "compounding": "not_applicable",
      "calendar": "not_applicable",
      "business_day_adjustment": "not_applicable",
      "settlement": {
        "lag": "not_applicable",
        "start_inclusion": "not_applicable",
        "timing": "comparison of two repo-rate observations with the same term and as-of date"
      },
      "rounding": {"precision": 0.0001, "method": "half_even", "applies_at": "output_boundary"},
      "viewpoint_ids": ["role.repo_cash_provider", "role.repo_cash_taker"],
      "sign_convention": {
        "positive": "GC repo rate - specific collateral repo rate is positive when specific collateral trades below GC on the repo-rate axis",
        "role.repo_cash_provider": "lower specific-collateral rate means lower rate income versus GC",
        "role.repo_cash_taker": "lower specific-collateral rate means lower funding cost versus GC"
      },
      "formula": {
        "id": "formula.repo_specialness_bps",
        "expression": "(gc_repo_rate - specific_collateral_repo_rate) * 10000",
        "inputs": ["gc_repo_rate", "specific_collateral_repo_rate"],
        "outputs": ["specialness_bps"]
      },
      "jurisdiction": "US",
      "knowledge_class": "stable_mechanic",
      "knowledge_as_of": "2026-09-06",
      "effective_from": null,
      "effective_to": null,
      "source_refs": ["source.ny_fed"],
      "review_status": "draft",
      "review": null,
      "supersedes": []
    },
