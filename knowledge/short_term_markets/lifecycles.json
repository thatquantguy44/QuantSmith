  "lifecycles": [
    {
      "id": "lifecycle.repo",
      "record_type": "lifecycle",
      "name": "Repo and reverse-repo lifecycle",
      "domain": "repo_reverse_repo",
      "product_ids": ["product.repo", "product.reverse_repo"],
      "initial_state_ids": ["repo.trade_agreed"],
      "terminal_state_ids": ["repo.terminated", "repo.defaulted"],
      "states": [
        {"id": "repo.trade_agreed", "name": "Trade agreed", "invariants": ["economic viewpoint and collateral identifier declared"]},
        {"id": "repo.start_settled", "name": "Start settled", "invariants": ["cash delivered and securities collateral received by opposite roles"]},
        {"id": "repo.open", "name": "Open repo", "invariants": ["rate accrual, mark, and margin obligations active"]},
        {"id": "repo.substitution_pending", "name": "Collateral substitution pending", "invariants": ["replacement collateral eligibility and haircut under review"]},
        {"id": "repo.margin_call_open", "name": "Margin call open", "invariants": ["mark or haircut change requires transfer by deadline"]},
        {"id": "repo.failed", "name": "Settlement fail", "invariants": ["expected cash or securities movement not completed"]},
        {"id": "repo.partially_unwound", "name": "Partially unwound", "invariants": ["remaining notional and collateral schedule restated"]},
        {"id": "repo.terminated", "name": "Terminated", "invariants": ["end cash and securities return completed"]},
        {"id": "repo.defaulted", "name": "Defaulted or closed out", "invariants": ["close-out process replaces normal settlement"]}
      ],
      "transitions": [
        {
          "event_id": "repo.start_settle",
          "from_state_id": "repo.trade_agreed",
          "to_state_id": "repo.start_settled",
          "initiating_role_id": "role.repo_buyer",
          "affected_role_ids": ["role.repo_seller", "role.repo_cash_provider", "role.repo_securities_provider"],
          "preconditions": ["trade terms, collateral, haircut, start date, and settlement instructions declared"],
