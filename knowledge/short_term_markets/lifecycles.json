          "security_movements": [{"id": "repo.start_collateral", "from_role_id": "role.repo_securities_provider", "to_role_id": "role.repo_securities_receiver", "direction": "securities_to_cash_provider"}],
          "margin_events": []
        },
        {
          "event_id": "repo.open_after_start",
          "from_state_id": "repo.start_settled",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker"],
          "preconditions": ["start settlement confirmed"],
          "cashflows": [],
          "security_movements": [],
          "margin_events": [{"id": "repo.initial_margin_state", "direction": "collateral value and haircut state active"}]
        },
        {
          "event_id": "repo.periodic_accrual",
          "from_state_id": "repo.open",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker"],
          "preconditions": ["repo remains open for accrual day"],
          "cashflows": [{"id": "repo.accrued_interest", "from_role_id": "role.repo_cash_taker", "to_role_id": "role.repo_cash_provider", "direction": "repo_rate_income_to_cash_provider"}],
          "security_movements": [],
          "margin_events": []
        },
        {
          "event_id": "repo.substitution_request",
          "from_state_id": "repo.open",
          "to_state_id": "repo.substitution_pending",
          "initiating_role_id": "role.repo_securities_provider",
          "affected_role_ids": ["role.repo_securities_receiver"],
          "preconditions": ["substitution permitted by agreement and replacement collateral identified"],
          "cashflows": [],
          "security_movements": [{"id": "repo.substitute_collateral", "from_role_id": "role.repo_securities_provider", "to_role_id": "role.repo_securities_receiver", "direction": "replacement_collateral_for_returned_collateral"}],
          "margin_events": [{"id": "repo.substitution_haircut_check", "direction": "eligibility and haircut reapplied"}]
        },
        {
          "event_id": "repo.substitution_complete",
          "from_state_id": "repo.substitution_pending",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_securities_receiver",
          "affected_role_ids": ["role.repo_securities_provider"],
          "preconditions": ["replacement collateral accepted and old collateral returned"],
          "cashflows": [],
          "security_movements": [{"id": "repo.old_collateral_return", "from_role_id": "role.repo_securities_receiver", "to_role_id": "role.repo_securities_provider", "direction": "old_collateral_returned"}],
          "margin_events": []
        },
        {
          "event_id": "repo.margin_call",
          "from_state_id": "repo.open",
          "to_state_id": "repo.margin_call_open",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker", "role.repo_securities_provider"],
          "preconditions": ["mark, exposure, or haircut movement breaches margin threshold"],
          "cashflows": [],
          "security_movements": [],
          "margin_events": [{"id": "repo.margin_transfer_due", "direction": "margin payer to margin receiver"}]
        },
        {
          "event_id": "repo.margin_satisfied",
          "from_state_id": "repo.margin_call_open",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_cash_taker",
          "affected_role_ids": ["role.repo_cash_provider"],
          "preconditions": ["called cash or collateral delivered by deadline"],
          "cashflows": [{"id": "repo.margin_cash_transfer", "from_role_id": "role.repo_cash_taker", "to_role_id": "role.repo_cash_provider", "direction": "margin_cash_if_cash_margin"}],
          "security_movements": [{"id": "repo.margin_collateral_transfer", "from_role_id": "role.repo_securities_provider", "to_role_id": "role.repo_securities_receiver", "direction": "margin_collateral_if_non_cash_margin"}],
          "margin_events": [{"id": "repo.margin_call_closed", "direction": "margin deficit cured"}]
        },
        {
          "event_id": "repo.partial_unwind",
          "from_state_id": "repo.open",
          "to_state_id": "repo.partially_unwound",
          "initiating_role_id": "role.repo_seller",
          "affected_role_ids": ["role.repo_buyer"],
          "preconditions": ["partial unwind permitted and remaining terms restated"],
          "cashflows": [{"id": "repo.partial_cash_return", "from_role_id": "role.repo_cash_taker", "to_role_id": "role.repo_cash_provider", "direction": "partial_repurchase_cash"}],
          "security_movements": [{"id": "repo.partial_collateral_return", "from_role_id": "role.repo_securities_receiver", "to_role_id": "role.repo_securities_provider", "direction": "partial_collateral_return"}],
          "margin_events": [{"id": "repo.remaining_margin_recalc", "direction": "remaining exposure recalculated"}]
        },
        {
          "event_id": "repo.partial_unwind_restated",
          "from_state_id": "repo.partially_unwound",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker"],
          "preconditions": ["remaining notional and collateral schedule accepted"],
          "cashflows": [],
          "security_movements": [],
          "margin_events": [{"id": "repo.restated_margin_state", "direction": "remaining margin state active"}]
        },
        {
          "event_id": "repo.settlement_fail",
          "from_state_id": "repo.open",
          "to_state_id": "repo.failed",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker", "role.repo_securities_provider", "role.repo_securities_receiver"],
          "preconditions": ["scheduled cash or securities movement did not complete"],
          "cashflows": [],
          "security_movements": [],
          "margin_events": [{"id": "repo.fail_exposure_flag", "direction": "fail exposure recorded"}]
        },
        {
          "event_id": "repo.fail_cured",
          "from_state_id": "repo.failed",
          "to_state_id": "repo.open",
          "initiating_role_id": "role.repo_cash_taker",
          "affected_role_ids": ["role.repo_cash_provider"],
          "preconditions": ["failed settlement obligation cured"],
          "cashflows": [],
          "security_movements": [],
          "margin_events": [{"id": "repo.fail_closed", "direction": "fail exposure removed or restated"}]
        },
        {
          "event_id": "repo.maturity_or_termination",
          "from_state_id": "repo.open",
          "to_state_id": "repo.terminated",
          "initiating_role_id": "role.repo_cash_taker",
          "affected_role_ids": ["role.repo_cash_provider", "role.repo_securities_receiver", "role.repo_securities_provider"],
          "preconditions": ["maturity, call, or agreed termination reached"],
          "cashflows": [{"id": "repo.end_cash", "from_role_id": "role.repo_cash_taker", "to_role_id": "role.repo_cash_provider", "direction": "repurchase_cash_plus_repo_interest"}],
          "security_movements": [{"id": "repo.end_collateral", "from_role_id": "role.repo_securities_receiver", "to_role_id": "role.repo_securities_provider", "direction": "collateral_return"}],
          "margin_events": [{"id": "repo.margin_release", "direction": "excess_margin_returned"}]
        },
        {
          "event_id": "repo.default",
          "from_state_id": "repo.open",
          "to_state_id": "repo.defaulted",
          "initiating_role_id": "role.repo_cash_provider",
          "affected_role_ids": ["role.repo_cash_taker"],
          "preconditions": ["default event declared by agreement or operating process"],
          "cashflows": [{"id": "repo.closeout_cash", "from_role_id": "role.repo_cash_taker", "to_role_id": "role.repo_cash_provider", "direction": "closeout_or_net_amount"}],
          "security_movements": [{"id": "repo.closeout_collateral", "from_role_id": "role.repo_securities_receiver", "to_role_id": "role.repo_securities_provider", "direction": "closeout_collateral_treatment"}],
          "margin_events": [{"id": "repo.default_margin_state", "direction": "normal margin process stops"}]
        }
      ],
      "jurisdiction": "US",
