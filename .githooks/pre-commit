#!/bin/sh
# Pre-commit hook for QuantSmith: run lightweight repository checks.

set -e

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '(^|/)\.DS_Store$'; then
  echo "Remove .DS_Store files before committing."
  exit 1
fi

for file in README.md agentic_dictionary.md docs/sdk_plan.md docs/handoff.md; do
  if [ ! -f "$file" ]; then
    echo "Required SDK document missing: $file"
    exit 1
  fi
done

# A public agent is any directory containing prompt.md, at any depth under agents/
# (this allows grouping agents into category folders such as agents/data_ingestion/).
for agent in $(find agents -type f -name prompt.md -exec dirname {} \; | sort -u); do
  for file in README.md prompt.md instructions.md tasks.md; do
    if [ ! -f "$agent/$file" ]; then
      echo "Public agent contract missing: $agent/$file"
      exit 1
    fi
  done
done

sh -n setup-hooks.sh
for hook in .githooks/*; do
  sh -n "$hook"
done

# Authorship: refuse to create a commit under an AI agent identity. This is the
# only place the check is cheap -- once the commit exists, fixing it means
# rewriting history. Blocking here regardless of QF_STAGE_ENFORCE, because an
# advisory warning at commit time is one the author has already scrolled past.
author="$(git config user.name || true) <$(git config user.email || true)>"
if printf '%s' "$author" | grep -qiE '(^|[^a-z])claude([^a-z]|$)|anthropic\.com|(^|[^a-z])codex([^a-z]|$)|openai\.com|chatgpt|copilot\[bot\]'; then
  echo "Refusing to commit: git identity is an AI agent -- $author"
  echo
  echo "Commits here are attributed to the human accountable for them."
  echo "Set a human identity:"
  echo "  git config user.name  'Your Name'"
  echo "  git config user.email 'you@users.noreply.github.com'"
  exit 1
fi

echo "QuantSmith pre-commit checks passed."
